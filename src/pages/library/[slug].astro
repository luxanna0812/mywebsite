---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { records, detailSections, timelineEntries, travelSpots } from '../../data/records';
export function getStaticPaths() {
  return records.map(record => ({ params: { slug: record.slug }, props: { record } }));
}
const { record } = Astro.props;
const sections = detailSections[record.slug] ?? [];
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<BaseLayout title={`${record.title} — 朱筱萌`}>
  <article class="detail">
    <a class="back-link" href={base}>← 返回 Library</a>
    <p class="eyebrow">RECORD {record.number} / PERSONAL COLLECTION</p>
    <h1>{record.title}</h1>
    <p class="detail-category">{record.category}</p>
    {record.slug === 'education' ? (
      <div class="timeline" aria-label="教育与实习时间线">
        <div class="timeline-line" aria-hidden="true"></div>
        {timelineEntries.map((entry, index) => (
          <section class={`timeline-item timeline-${entry.type}`} style={`--timeline-index: ${index}`}>
            <div class="timeline-marker" aria-hidden="true"></div>
            <div class="timeline-card">
              <div class="timeline-meta"><span>{entry.period}</span><b>{entry.type === 'work' ? 'WORK' : entry.type === 'project' ? 'PROJECT' : 'EDUCATION'}</b></div>
              <h2>{entry.title}</h2>
              {entry.location && <p class="timeline-location">{entry.location}</p>}
              <p class="detail-intro">{entry.description}</p>
              <ul>{entry.highlights.map(highlight => <li>{highlight}</li>)}</ul>
              <div class="detail-tags">{entry.tags.map(tag => <span>{tag}</span>)}</div>
            </div>
          </section>
        ))}
      </div>
    ) : <div class="detail-sections">
      {sections.map(section => (
        <section class="detail-section">
          <div class="detail-section-heading">
            <h2>{section.heading}</h2>
            {section.period && <span>{section.period}</span>}
          </div>
          {record.slug === 'visual-work' && section.heading === '在路上' ? (
            <div class="travel-map-wrap">
              <p class="detail-intro">从东亚到欧洲，从城市漫游到山路徒步，这些足迹构成了一张仍在延伸的个人地图。</p>
              <div class="travel-map" aria-label="旅行足迹地图">
                <svg viewBox="0 0 100 70" role="img" aria-labelledby="travel-map-title">
                  <title id="travel-map-title">朱筱萌的旅行足迹</title>
                  <path class="map-land" d="M8 21l8-7 13 2 7 7-4 7-10 1-5 8-8-3-4-8zm28 16l9-3 9 5 5 8-5 4-8-2-4 8-9-2-3-7zm22-11l11-5 14 3 8 8-4 7-10-1-4 9-10 3-7-7 4-9zm-1 20l8 2 4 10-7 8-6-5 2-8-6-3zm18 2l9-2 8 5 2 8-6 2-5-4-8 1-4-5z" />
                  <path class="map-land map-land-faint" d="M19 48l8 2 5 8-5 6-9-3-3-7zm57-26l8-2 8 5-1 5-8-1-5-4z" />
                  {travelSpots.map((spot, index) => (
                    <g class="travel-pin" style={`--pin-index: ${index}; --pin-x: ${spot.x}; --pin-y: ${spot.y}`}>
                      <circle cx={spot.x} cy={spot.y} r=".85" />
                      <circle class="travel-pulse" cx={spot.x} cy={spot.y} r="2.2" />
                      <title>{spot.name}</title>
                    </g>
                  ))}
                </svg>
                <div class="travel-map-label">A PERSONAL ATLAS / {travelSpots.length} PLACES</div>
              </div>
              <div class="travel-list" aria-label="去过的国家和地区">
                {travelSpots.map((spot, index) => <span><i>{String(index + 1).padStart(2, '0')}</i>{spot.name}</span>)}
              </div>
            </div>
          ) : section.intro && <p class="detail-intro">{section.intro}</p>}
          {section.bullets && <ul>{section.bullets.map(bullet => <li>{bullet}</li>)}</ul>}
          {section.links && <nav class="detail-links" aria-label={`${section.heading}链接`}>
            {section.links.map(link => link.url
              ? <a href={link.url} target="_blank" rel="noopener noreferrer">{link.label} ↗</a>
              : <span>{link.label}</span>
            )}
          </nav>}
          {section.tags && <div class="detail-tags">{section.tags.map(tag => <span>{tag}</span>)}</div>}
        </section>
      ))}
    </div>}
    <a class="back-link" href={base}>继续翻阅收藏 ↗</a>
  </article>
</BaseLayout>

{record.slug === 'education' && <script>
  const revealTimeline = () => {
    const timeline = document.querySelector('.timeline');
    if (!timeline) return;
    timeline.classList.add('timeline-motion');
    const items = timeline.querySelectorAll<HTMLElement>('.timeline-item');
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      items.forEach(item => item.classList.add('is-visible'));
      return;
    }
    const observer = new IntersectionObserver((entries, currentObserver) => {
      entries.forEach(entry => {
        if (!entry.isIntersecting) return;
        entry.target.classList.add('is-visible');
        currentObserver.unobserve(entry.target);
      });
    }, { rootMargin: '0px 0px -12% 0px', threshold: 0.12 });
    items.forEach(item => observer.observe(item));
  };
  revealTimeline();
  document.addEventListener('astro:page-load', revealTimeline, { once: true });
</script>}
