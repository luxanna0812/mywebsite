---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DetailHeader from '../../components/DetailHeader.astro';
import PhotoCarousel from '../../components/PhotoCarousel.astro';
import { records, detailSections, timelineEntries, travelSpots } from '../../data/records';
import { linerNotes } from '../../data/liner-notes';
import '../../styles/detail.css';
export function getStaticPaths() {
  return records.map(record => ({ params: { slug: record.slug }, props: { record } }));
}
const { record } = Astro.props;
const sections = detailSections[record.slug] ?? [];
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const note = linerNotes[record.slug];
const indexEntries = record.slug === 'education'
  ? timelineEntries.map((entry, index) => ({ title: entry.title, id: `track-${index + 1}` }))
  : sections.map((section, index) => ({ title: section.heading, id: `track-${index + 1}` }));
const previousRecord = records[(record.order + records.length - 2) % records.length];
const nextRecord = records[record.order % records.length];
---
<BaseLayout title={`${record.title} — 朱筱萌`}>
  <article class={`detail record-detail record-${record.slug}`} style={`--record-accent: ${note.accent}; --record-paper: ${note.paper}`}>
    <a class="back-link" href={base}>← 返回 Library</a>
    <DetailHeader record={record} />
    {record.slug === 'content' && <PhotoCarousel />}
    <div class="detail-layout">
      <aside class="detail-margin">
        <div class="detail-margin-inner">
          <p class="index-label">ON THIS RECORD <span>/ 曲目索引</span></p>
          <nav class="track-index" aria-label="本页章节">
            {record.slug === 'content' && <a href="#photo-gallery"><b>↗</b><span>摄影手记 · 十个瞬间</span></a>}
            {indexEntries.map((entry, index) => <a href={`#${entry.id}`}><b>{String(index + 1).padStart(2, '0')}</b><span>{entry.title}</span></a>)}
          </nav>
          <div class="margin-thought">
            <span class="margin-orbit" aria-hidden="true"><i></i></span>
            <p>{note.thought}</p>
            <span>NOTES IN THE MARGIN</span>
          </div>
        </div>
      </aside>
      <div class="detail-main">
    {record.slug === 'education' ? (
      <div class="timeline" aria-label="教育与实习时间线">
        <div class="timeline-line" aria-hidden="true"></div>
        {timelineEntries.map((entry, index) => (
          <section id={`track-${index + 1}`} class={`timeline-item timeline-${entry.type}`} style={`--timeline-index: ${index}`}>
            <div class="timeline-marker" aria-hidden="true"></div>
            <div class="timeline-card">
              <div class="timeline-meta"><span>{entry.period}</span><b>{entry.type === 'work' ? 'WORK' : entry.type === 'project' ? 'PROJECT' : 'EDUCATION'}</b></div>
              <h2>{entry.title}</h2>
              {entry.location && <p class="timeline-location">{entry.location}</p>}
              <p class="detail-intro">{entry.description}</p>
              <ul>{entry.highlights.map(highlight => <li>{highlight}</li>)}</ul>
              <div class="detail-tags">{entry.tags.map(tag => <span>{tag}</span>)}</div>
            </div>
          </section>
        ))}
      </div>
    ) : <div class="detail-sections">
      {sections.map((section, index) => (
        <section class="detail-section" id={`track-${index + 1}`}>
          <p class="section-track">{record.number}.{String(index + 1).padStart(2, '0')} <span>/{record.category}</span></p>
          <div class="detail-section-heading">
            <h2>{section.heading}</h2>
            {section.period && <span>{section.period}</span>}
          </div>
          {record.slug === 'visual-work' && section.heading === '在路上' ? (
            <div class="travel-map-wrap">
              <p class="detail-intro">从东亚到欧洲，从城市漫游到山路徒步，这些足迹构成了一张仍在延伸的个人地图。</p>
              <div class="travel-map" aria-label="旅行足迹地图">
                <svg viewBox="0 0 100 70" role="img" aria-labelledby="travel-map-title">
                  <title id="travel-map-title">朱筱萌的旅行足迹</title>
                  <path class="map-land" d="M8 21l8-7 13 2 7 7-4 7-10 1-5 8-8-3-4-8zm28 16l9-3 9 5 5 8-5 4-8-2-4 8-9-2-3-7zm22-11l11-5 14 3 8 8-4 7-10-1-4 9-10 3-7-7 4-9zm-1 20l8 2 4 10-7 8-6-5 2-8-6-3zm18 2l9-2 8 5 2 8-6 2-5-4-8 1-4-5z" />
                  <path class="map-land map-land-faint" d="M19 48l8 2 5 8-5 6-9-3-3-7zm57-26l8-2 8 5-1 5-8-1-5-4z" />
                  {travelSpots.map((spot, index) => (
                    <g class="travel-pin" style={`--pin-index: ${index}; --pin-x: ${spot.x}; --pin-y: ${spot.y}`}>
                      <circle cx={spot.x} cy={spot.y} r=".85" />
                      <circle class="travel-pulse" cx={spot.x} cy={spot.y} r="2.2" />
                      <title>{spot.name}</title>
                    </g>
                  ))}
                </svg>
                <div class="travel-map-label">A PERSONAL ATLAS / {travelSpots.length} PLACES</div>
              </div>
              <div class="travel-list" aria-label="去过的国家和地区">
                {travelSpots.map((spot, index) => <span><i>{String(index + 1).padStart(2, '0')}</i>{spot.name}</span>)}
              </div>
            </div>
          ) : section.intro && <p class="detail-intro">{section.intro}</p>}
          {section.caseImage && <figure class="case-study-image">
            <img src={`${base}${section.caseImage}`} alt={section.imageAlt ?? section.heading} loading="lazy" decoding="async" />
            <figcaption>自律搭子网站 / 产品界面与视觉方向</figcaption>
          </figure>}
          {section.bullets && <ul>{section.bullets.map(bullet => <li>{bullet}</li>)}</ul>}
          {section.links && <nav class="detail-links" aria-label={`${section.heading}链接`}>
            {section.links.map(link => link.url
              ? <a href={link.url} target="_blank" rel="noopener noreferrer">{link.label} ↗</a>
              : <span>{link.label}</span>
            )}
          </nav>}
          {section.tags && <div class="detail-tags">{section.tags.map(tag => <span>{tag}</span>)}</div>}
          {section.reflection && <aside class="experience-note"><span>回声 /</span><p>{section.reflection}</p></aside>}
        </section>
      ))}
    </div>}
      </div>
    </div>
    <nav class="record-pagination" aria-label="继续翻阅唱片">
      <a href={previousRecord.href}>
        <img src={previousRecord.cover} alt="" width="62" height="62" loading="lazy" />
        <span><small>← 上一张 / {previousRecord.number}</small><strong>{previousRecord.title}</strong><em>{previousRecord.category}</em></span>
      </a>
      <a href={nextRecord.href}>
        <span><small>下一张 / {nextRecord.number} →</small><strong>{nextRecord.title}</strong><em>{nextRecord.category}</em></span>
        <img src={nextRecord.cover} alt="" width="62" height="62" loading="lazy" />
      </a>
    </nav>
    <div class="detail-colophon"><span>PERSONAL COLLECTION / {record.number} OF 09</span><a href={base}>回到唱片收藏 ↗</a></div>
  </article>
</BaseLayout>

<script>
  import '../../scripts/detail-navigation';
</script>
