---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import AudioControls from '../components/AudioControls.astro';
interface Props { title?: string }
const { title = '朱筱萌 — Personal Library' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="朱筱萌的个人唱片 Library：经历、作品与持续的兴趣。" />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body>
    <a class="skip-link" href="#main">跳到主要内容</a>
    <div class="site-wrap">
      <header class="site-header">
        <a class="identity" href={base} aria-label="朱筱萌，首页"><span class="identity-mark" aria-hidden="true">✳</span><span>朱筱萌<small>战略传播 · 广告 · 文化研究</small></span></a>
        <nav aria-label="主导航"><a href={base} aria-current={Astro.url.pathname === base ? 'page' : undefined}>Library <span>09</span></a><a href={`${base}library/profile/`} aria-current={Astro.url.pathname.replace(/\/$/, '') === `${base}library/profile` ? 'page' : undefined}>关于 ↗</a></nav>
      </header>
      <main id="main"><slot /></main>
      <AudioControls />
      <footer class="site-footer"><span>朱筱萌 <span class="muted">/ Personal Library</span></span><span>经历、作品，以及未完待续的好奇心。</span><a href="#main">回到顶部 ↑</a></footer>
    </div>
  </body>
</html>
