---
import type { RecordEntry } from '../data/records';
interface Props { record: RecordEntry }
const { record } = Astro.props;
---
<li class="record-item">
  <a class="record-link" href={record.href} aria-label={`${record.number} ${record.title} · ${record.category}`}>
    <div class="record-object">
      <div class="vinyl" aria-hidden="true"><span>{record.number}</span></div>
      <div class:list={['sleeve', record.coverStyle]}>
        {record.cover ? <img src={record.cover} alt="" width="1400" height="1400" loading={record.order <= 3 ? 'eager' : 'lazy'} decoding="async" /> : <>
          <div class="cover-top" aria-hidden="true"><span>XM / PERSONAL ARCHIVE</span><span>{record.number}</span></div>
          <div class="artwork" aria-hidden="true"><div class="shape shape-one"></div><div class="shape shape-two"></div><span class="cover-word">{record.coverText}</span>{record.coverStyle === 'path' && <span class="art-symbol">↗</span>}{record.coverStyle === 'notes' && <span class="art-symbol">＊</span>}</div>
          <div class="cover-bottom" aria-hidden="true"><span>{record.title}</span><span>SIDE {record.number} / 33⅓</span></div>
        </>}
      </div>
    </div>
    <div class="record-label"><span class="record-number">{record.number}</span><div><h2>{record.title}</h2><p>{record.category}{record.year && ` · ${record.year}`}</p></div><span class="open-record" aria-hidden="true">↗</span></div>
  </a>
</li>
