---
import type { RecordEntry } from '../data/records';
import { linerNotes } from '../data/liner-notes';
interface Props { record: RecordEntry }
const { record } = Astro.props;
const note = linerNotes[record.slug];
---
<header class="liner-header">
  <div class="liner-heading">
    <p class="eyebrow">RECORD {record.number} <span>/</span> {note.label}</p>
    <h1>{record.title}</h1>
    <p class="liner-category">{record.category}<span>朱筱萌的私人收藏</span></p>
    <p class="liner-intro">{note.intro}</p>
    <div class="liner-keywords" aria-label="本张唱片关键词">
      {note.keywords.map((keyword, index) => <span><i>0{index + 1}</i>{keyword}</span>)}
    </div>
  </div>
  <div class="liner-art" aria-hidden="true">
    <div class="liner-disc"><span>{record.number}<small>SIDE A</small></span></div>
    <div class="liner-cover"><img src={record.cover} alt="" width="400" height="400" /></div>
    <div class="liner-stamp">PERSONAL LIBRARY<br /><b>33⅓ RPM · STEREO</b></div>
  </div>
</header>
<div class="liner-divider"><span>LINER NOTES <i>/ 唱片内页</i></span><span>慢慢读，也慢慢听。</span></div>

<style>
  .liner-header { display: grid; grid-template-columns: minmax(0, 1fr) 290px; gap: 64px; align-items: center; padding: 5px 0 46px; }
  .eyebrow { color: var(--record-accent); line-height: 1.8; }
  .eyebrow span { margin: 0 8px; opacity: .5; }
  h1 { font-size: clamp(48px, 5.8vw, 78px); max-width: 730px; }
  .liner-category { display: flex; align-items: center; flex-wrap: wrap; gap: 16px; font-size: 15px; margin: 20px 0; }
  .liner-category span { color: var(--muted); font-size: 10px; border-left: 1px solid var(--line); padding-left: 16px; letter-spacing: 1px; }
  .liner-intro { font-size: 14px; color: #66635b; line-height: 2; max-width: 490px; margin: 24px 0; text-wrap: pretty; }
  .liner-keywords { display: flex; gap: 24px; font-size: 10px; letter-spacing: 1px; padding-top: 6px; }
  .liner-keywords span { display: flex; gap: 9px; align-items: center; }
  .liner-keywords i { font-family: var(--serif); font-style: italic; color: var(--record-accent); }
  .liner-art { position: relative; width: 270px; height: 268px; margin-top: 4px; }
  .liner-cover { position: absolute; width: 206px; height: 206px; top: 18px; left: 0; padding: 0; transform: rotate(-6deg); box-shadow: 1px 1px 0 #c4bba9, 3px 3px 0 #ded7ca, 5px 9px 16px #28201528; }
  .liner-cover img { display: block; width: 100%; height: 100%; object-fit: contain; background: var(--record-paper); }
  .liner-disc { position: absolute; width: 205px; height: 205px; right: 0; top: 11px; display: grid; place-items: center; border-radius: 50%; background: repeating-radial-gradient(circle, #292a26 0 2px, #383932 3px, #242521 4px 7px); box-shadow: 3px 6px 10px #28201525; }
  .liner-disc > span { width: 73px; height: 73px; border-radius: 50%; display: flex; justify-content: center; align-items: center; flex-direction: column; background: var(--record-paper); font-family: var(--serif); font-size: 25px; color: var(--record-accent); }
  .liner-disc small { font-family: Arial, sans-serif; font-size: 6px; letter-spacing: 1px; margin-top: 6px; }
  .liner-stamp { position: absolute; bottom: 0; right: 2px; font-size: 8px; letter-spacing: 1.5px; line-height: 1.8; text-align: right; color: var(--record-accent); }
  .liner-stamp b { font-weight: 400; font-size: 7px; color: var(--muted); }
  .liner-divider { display: flex; justify-content: space-between; gap: 18px; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); padding: 15px 0; font-size: 9px; letter-spacing: 1.5px; }
  .liner-divider i { font-style: normal; letter-spacing: 1px; color: var(--muted); margin-left: 8px; }
  .liner-divider > span:last-child { color: var(--muted); letter-spacing: .8px; }
  @media (max-width: 1000px) { .liner-header { grid-template-columns: minmax(0, 1fr) 210px; gap: 28px; } .liner-art { transform: scale(.8); transform-origin: center left; width: 270px; } }
  @media (max-width: 700px) {
    .liner-header { grid-template-columns: minmax(0, 1fr); gap: 24px; padding-bottom: 30px; }
    .liner-heading { grid-row: 2; }
    .liner-art { height: 144px; width: 185px; transform: none; margin: 0 0 8px; }
    .liner-cover { width: 128px; height: 128px; top: 9px; left: 7px; }
    .liner-disc { width: 132px; height: 132px; right: 0; top: 0; }
    .liner-disc > span { width: 48px; height: 48px; font-size: 18px; }
    .liner-stamp { display: none; }
    h1 { font-size: clamp(43px, 11vw, 62px); letter-spacing: -2px; }
    .liner-intro { margin: 18px 0 20px; font-size: 13px; }
    .liner-category { margin: 15px 0; font-size: 14px; gap: 12px; }
    .liner-category span { padding-left: 12px; font-size: 9px; }
    .liner-divider { font-size: 8px; letter-spacing: .6px; }
    .liner-divider i { margin-left: 4px; }
  }
</style>
